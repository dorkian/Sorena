# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# --- LLM provider API keys ---
GROQ_API_KEY=
GEMINI_API_KEY=

# NVIDIA NIM (build.nvidia.com) -- free-tier OpenAI-compatible endpoint giving
# access to NVIDIA's own hosted models (Nemotron) plus partner models (GLM,
# MiniMax, Qwen, etc). Get a key at https://build.nvidia.com (Login -> open
# any model page -> "Generate API Key"). litellm reads this exact var name
# for its nvidia_nim/ provider prefix -- see router.py's PROVIDER_CHAIN.
NVIDIA_NIM_API_KEY=

# OpenRouter -- OpenAI-compatible endpoint giving access to GPT models (and
# hundreds of others) through one API. Get a key at https://openrouter.ai
# (Sign in -> Keys -> Create Key). litellm reads this exact var name for its
# openrouter/ provider prefix -- see router.py's PROVIDER_CHAIN.
OPENROUTER_API_KEY=

# --- Web search tool ---
TAVILY_API_KEY=

# --- Provider fallback chain (optional) ---
# Comma-separated litellm model strings, tried in order -- router.py falls
# through to the next one if a call fails or is locally rate-limited. Add,
# remove, or reorder models here instead of editing src/sorena/config.py.
# Default if unset: groq/llama-3.3-70b-versatile,gemini/gemini-3.1-flash-lite
#SORENA_PROVIDER_CHAIN=groq/llama-3.3-70b-versatile,nvidia_nim/nvidia/nemotron-3-ultra-550b-a55b,openrouter/openai/gpt-oss-120b,gemini/gemini-3.1-flash-lite

# Comma-separated model:requests-per-minute pairs, one per model in the
# chain above -- caps how often each is called locally (independent of
# whatever rate limit the provider itself enforces).
# Default if unset: groq/llama-3.3-70b-versatile:30,gemini/gemini-3.1-flash-lite:15
#SORENA_RATE_LIMITS_RPM=groq/llama-3.3-70b-versatile:30,nvidia_nim/nvidia/nemotron-3-ultra-550b-a55b:40,openrouter/openai/gpt-oss-120b:30,gemini/gemini-3.1-flash-lite:15

# --- Optional path overrides ---
#SORENA_CV_PATH=
#SORENA_CV_PATH_FALLBACK=
#SORENA_VAULT_SESSIONS_PATH=

# --- Phase 7: JobScout graph (Postgres + pgvector) ---
# Connection string for the Postgres instance started by `docker compose up
# postgres` (see docker-compose.yml). One instance backs both the pgvector
# store (Ash's CV + past job-application data) and the LangGraph
# checkpointer -- see docs/adr/0014-jobscout-langgraph-vector-search.md.
# Default matches docker-compose.yml's postgres service out of the box.
#SORENA_POSTGRES_URI=postgresql://sorena:sorena@localhost:5432/sorena_jobscout

# Opt-in only -- sends JobScout graph traces to LangSmith (LangChain's
# hosted tracing product) instead of/alongside the default local
# traces/runs.jsonl sink. Off by default to keep Sorena $0/local-first; only
# turn this on deliberately for a demo. Needs LANGCHAIN_API_KEY too if set.
#SORENA_LANGSMITH=false
